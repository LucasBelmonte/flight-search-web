# Normaliza line endings: LF no repositório, nativo no working copy.
# Sem isto, quem desenvolve no Windows gera diffs onde o arquivo inteiro
# aparece como alterado.
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary

# Gerado de openapi.yaml — marcar ajuda o GitHub a colapsar o diff na revisão.
src/app/core/api/types.ts linguist-generated=true
package-lock.json linguist-generated=true
