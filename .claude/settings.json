{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run test*)",
      "Bash(npm run build*)",
      "Bash(npm run lint*)",
      "Bash(npx prettier*)",
      "Bash(npx eslint*)",
      "Bash(node scripts/check-contrast.mjs)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)"
    ],
    "deny": ["Read(./.env)", "Edit(./.env)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-secrets.mjs",
            "timeout": 10,
            "statusMessage": "Verificando segredos..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "if": "Bash(git *)",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-git.mjs",
            "timeout": 10,
            "statusMessage": "Verificando operação git..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/format-web.mjs",
            "timeout": 120,
            "statusMessage": "Prettier + ESLint + contraste..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/run-tests.mjs",
            "timeout": 300,
            "statusMessage": "Rodando os testes...",
            "async": true
          }
        ]
      }
    ]
  }
}
